# Consent Manager configuration. All vars are prefixed CONSENT_MANAGER_.
# Copy to .env for local runs.

# ── Database ──────────────────────────────────────────────────────────────
CONSENT_MANAGER_DB_DRIVER=postgresql+asyncpg
CONSENT_MANAGER_DB_USERNAME=postgres
CONSENT_MANAGER_DB_PASSWORD=postgres
CONSENT_MANAGER_DB_HOSTNAME=localhost
CONSENT_MANAGER_DB_PORT=5432
CONSENT_MANAGER_DB_DBNAME=consent_manager_db

# NOTE: the data controller is a per-binding attribute: a partner is bound to one or more controllers at onboarding
# (one shared CM serves many modules) — there is no global controller setting.

# ── CM receipt signing key (asymmetric, PKCS#12) ──────────────────────────
# Leave the path unset for local dev — an EPHEMERAL key is generated (fine for a
# single local process; receipts won't verify across restarts/pods).
# To sign with a real key, point P12_PATH at a .p12 keystore (+ its password).
# In Kubernetes the Helm chart supplies this: a bundled demo key by default, or
# a Secret you provide (signingKey.mode = demo | existing | inline). Generate one:
#   openssl genpkey -algorithm ed25519 -out cm_key.pem
#   openssl req -new -x509 -key cm_key.pem -out cm_cert.pem -days 3650 -subj "/CN=openg2p-consent-manager"
#   openssl pkcs12 -export -inkey cm_key.pem -in cm_cert.pem -out cm_signing.p12 -passout pass:changeit
# CONSENT_MANAGER_CM_SIGNING_P12_PATH=/path/to/cm_signing.p12
# CONSENT_MANAGER_CM_SIGNING_P12_PASSWORD=changeit
# Fallback PEM (used only if no .p12 path is set):
# CONSENT_MANAGER_CM_SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CONSENT_MANAGER_CM_SIGNING_KID=cm-2025-01
# Algorithm is auto-detected from the key type; this is only a fallback hint.
CONSENT_MANAGER_CM_SIGNING_ALGORITHM=EdDSA

# ── Replay / freshness ────────────────────────────────────────────────────
CONSENT_MANAGER_REPLAY_FRESHNESS_WINDOW_SEC=300

# ── Hot-path partner cache (pod-local TTL) ────────────────────────────────
CONSENT_MANAGER_PARTNER_CACHE_ENABLED=true
CONSENT_MANAGER_PARTNER_CACHE_TTL_SEC=60

# ── Caller authentication (Keycloak) ──────────────────────────────────────
# Protects admin, validate, lifecycle, and /my endpoints. Set auth_enabled=false
# only for local dev (tokens then accepted unverified, role checks pass).
CONSENT_MANAGER_AUTH_ENABLED=true
CONSENT_MANAGER_AUTH_ISSUER=https://keycloak.example.org/realms/staff
CONSENT_MANAGER_AUTH_JWKS_URL=https://keycloak.example.org/realms/staff/protocol/openid-connect/certs
CONSENT_MANAGER_AUTH_AUDIENCE=
CONSENT_MANAGER_AUTH_ADMIN_ROLE=CONSENT_MANAGER_ADMIN
CONSENT_MANAGER_SUBJECT_DEFAULT_ID_TYPE=national_id

# ── OIDC (origination flow ID-token submitted to /authenticate) ───────────
# The IdP the subject authenticated with (may be the same Keycloak realm).
CONSENT_MANAGER_OIDC_JWKS_URL=
CONSENT_MANAGER_OIDC_ISSUER=
CONSENT_MANAGER_OIDC_AUDIENCE=

# ── Server ────────────────────────────────────────────────────────────────
CONSENT_MANAGER_APP_HOST=0.0.0.0
CONSENT_MANAGER_APP_PORT=8000
CONSENT_MANAGER_NO_OF_WORKERS=4
