  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('now', new Date().toISOString());",
          "// Every variable a run needs (the environment file next to this collection; secrets with --env-var).",
          "['bene_api_url', 'staff_api_url', 'esignet_api_url', 'keycloak_url', 'staff_realm', 'staff_client_id',",
          " 'staff_username', 'staff_password', 'partner_audience', 'data_controller', 'data_scope', 'purpose_code',",
          " 'subject_id_type', 'farmer_national_id', 'other_national_id', 'otp'].forEach(k => {",
          "  if (pm.variables.get(k)) return;",
          "  pm.execution.setNextRequest(null);  // stop the run",
          "  throw new Error(`Variable '${k}' is not set: select the environment 'Consent Manager - Bene API (eSignet login)' or pass --env-var ${k}=...`);",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('no server error', () => pm.expect(pm.response.code, pm.response.text()).to.be.below(500));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 Setup (service raises requests)",
      "item": [
        {
          "name": "0a Staff token (Keycloak staff realm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('staff token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staff_token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{keycloak_url}}/realms/{{staff_realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{staff_client_id}}"
                },
                {
                  "key": "username",
                  "value": "{{staff_username}}"
                },
                {
                  "key": "password",
                  "value": "{{staff_password}}"
                }
              ]
            },
            "description": "Gets a staff access token from Keycloak (password grant). Setup only: a service raises the consent requests the farmer then answers."
          }
        },
        {
          "name": "0b Find the partner binding",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json().find(x => x.controller_id === pm.variables.get('data_controller'));",
                  "pm.test('binding found', () => pm.expect(b).to.be.an('object'));",
                  "pm.collectionVariables.set('binding_id', b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "url": "{{staff_api_url}}/partners?audience={{partner_audience}}",
            "description": "Finds the partner's binding for `{{data_controller}}`; its ID is the `partner_id` of the requests raised next."
          }
        },
        {
          "name": "0c Raise request for the farmer (to approve)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('raised 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('rid_approve', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bene_api_url}}/consent-requests",
            "body": {
              "mode": "raw",
              "raw": "{\"subject_id\": {\"type\": \"{{subject_id_type}}\", \"value\": \"{{farmer_national_id}}\"}, \"partner_id\": \"{{binding_id}}\", \"purpose\": {\"code\": \"{{purpose_code}}\"}, \"grants\": [{\"data_controller\": \"{{data_controller}}\", \"data_scopes\": [\"{{data_scope}}\"]}]}"
            },
            "description": "Raises a consent request for `{{farmer_national_id}}` as a service (staff token). This is the only non-farmer call on the bene API."
          }
        },
        {
          "name": "0d Raise request for the farmer (to deny)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('raised 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('rid_deny', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bene_api_url}}/consent-requests",
            "body": {
              "mode": "raw",
              "raw": "{\"subject_id\": {\"type\": \"{{subject_id_type}}\", \"value\": \"{{farmer_national_id}}\"}, \"partner_id\": \"{{binding_id}}\", \"purpose\": {\"code\": \"{{purpose_code}}\"}, \"grants\": [{\"data_controller\": \"{{data_controller}}\", \"data_scopes\": [\"{{data_scope}}\"]}]}"
            },
            "description": "Raises a consent request for `{{farmer_national_id}}` as a service (staff token). This is the only non-farmer call on the bene API."
          }
        },
        {
          "name": "0e Raise request for another farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('raised 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('rid_other', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bene_api_url}}/consent-requests",
            "body": {
              "mode": "raw",
              "raw": "{\"subject_id\": {\"type\": \"{{subject_id_type}}\", \"value\": \"{{other_national_id}}\"}, \"partner_id\": \"{{binding_id}}\", \"purpose\": {\"code\": \"{{purpose_code}}\"}, \"grants\": [{\"data_controller\": \"{{data_controller}}\", \"data_scopes\": [\"{{data_scope}}\"]}]}"
            },
            "description": "Raises a consent request for `{{other_national_id}}` (staff token), used to check that a farmer cannot see or answer someone else's request."
          }
        }
      ],
      "description": "Setup: a service (staff token) raises the consent requests used below."
    },
    {
      "name": "1 Bene API auth (eSignet login, API client)",
      "item": [
        {
          "name": "1a Auth config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bene API auth enabled', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().enabled).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{bene_api_url}}/beneficiary/auth/config",
            "description": "Public: tells a client whether the national-ID login is on and which provider it uses."
          }
        },
        {
          "name": "1b Login (no return_url) -> 302 to eSignet",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "pm.test('302 to eSignet /authorize', () => { pm.response.to.have.status(302); pm.expect(loc).to.include('/authorize?'); });",
                  "const q = {};",
                  "loc.split('?')[1].split('&').forEach(p => { const i = p.indexOf('='); q[p.slice(0, i)] = decodeURIComponent(p.slice(i + 1).replace(/\\+/g, ' ')); });",
                  "pm.test('PKCE S256 + state + nonce', () => { pm.expect(q.code_challenge_method).to.eql('S256'); pm.expect(q.state).to.be.ok; pm.expect(q.nonce).to.be.ok; });",
                  "['client_id', 'redirect_uri', 'scope', 'state', 'nonce', 'code_challenge', 'acr_values', 'claims'].forEach(k => pm.collectionVariables.set('q_' + k, q[k] || ''));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{bene_api_url}}/beneficiary/auth/login",
            "description": "Starts the login as an **API client** (no `return_url`). The bene API answers `302` to eSignet `/authorize` with PKCE (S256), `state` and `nonce`; the test keeps the query for the eSignet calls."
          }
        },
        {
          "name": "1c eSignet CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('csrf token', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('xsrf', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{esignet_api_url}}/csrf/token",
            "description": "eSignet: CSRF token for the next calls.\n\nThis is one of the calls the eSignet login page makes (the collection plays the page, so no browser is needed). It works with eSignet's **mock identity system** only (fixed OTP); against a real ID system log in through the browser instead."
          }
        },
        {
          "name": "1d eSignet oauth-details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('oauth-details ok', () => { pm.response.to.have.status(200); pm.expect(body.errors || []).to.be.empty; });",
                  "pm.collectionVariables.set('txn', body.response.transactionId);",
                  "const hash = CryptoJS.SHA256(JSON.stringify(body.response)).toString(CryptoJS.enc.Base64).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.collectionVariables.set('oauth_hash', hash);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{esignet_api_url}}/authorization/v3/oauth-details",
            "body": {
              "mode": "raw",
              "raw": "{\"requestTime\": \"{{now}}\", \"request\": {\"clientId\": \"{{q_client_id}}\", \"scope\": \"{{q_scope}}\", \"responseType\": \"code\", \"redirectUri\": \"{{q_redirect_uri}}\", \"display\": \"popup\", \"prompt\": \"login\", \"acrValues\": \"{{q_acr_values}}\", \"nonce\": \"{{q_nonce}}\", \"state\": \"{{q_state}}\", \"claimsLocales\": \"en\", \"uiLocales\": \"en\", \"claims\": {{q_claims}}, \"codeChallenge\": \"{{q_code_challenge}}\", \"codeChallengeMethod\": \"S256\"}}"
            },
            "description": "eSignet: opens the login transaction for the authorize request (client, redirect URI, claims, PKCE).\n\nThis is one of the calls the eSignet login page makes (the collection plays the page, so no browser is needed). It works with eSignet's **mock identity system** only (fixed OTP); against a real ID system log in through the browser instead."
          }
        },
        {
          "name": "1e eSignet send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP sent', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors || []).to.be.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "oauth-details-key",
                "value": "{{txn}}"
              },
              {
                "key": "oauth-details-hash",
                "value": "{{oauth_hash}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{esignet_api_url}}/authorization/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\"requestTime\": \"{{now}}\", \"request\": {\"transactionId\": \"{{txn}}\", \"individualId\": \"{{farmer_national_id}}\", \"otpChannels\": [\"phone\"], \"captchaToken\": \"x\"}}"
            },
            "description": "eSignet: sends the OTP to the farmer's phone.\n\nThis is one of the calls the eSignet login page makes (the collection plays the page, so no browser is needed). It works with eSignet's **mock identity system** only (fixed OTP); against a real ID system log in through the browser instead."
          }
        },
        {
          "name": "1f eSignet authenticate (OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('authenticated', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().errors || []).to.be.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "oauth-details-key",
                "value": "{{txn}}"
              },
              {
                "key": "oauth-details-hash",
                "value": "{{oauth_hash}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{esignet_api_url}}/authorization/v3/authenticate",
            "body": {
              "mode": "raw",
              "raw": "{\"requestTime\": \"{{now}}\", \"request\": {\"transactionId\": \"{{txn}}\", \"individualId\": \"{{farmer_national_id}}\", \"challengeList\": [{\"authFactorType\": \"OTP\", \"challenge\": \"{{otp}}\", \"format\": \"alpha-numeric\"}]}}"
            },
            "description": "eSignet: checks the OTP.\n\nThis is one of the calls the eSignet login page makes (the collection plays the page, so no browser is needed). It works with eSignet's **mock identity system** only (fixed OTP); against a real ID system log in through the browser instead."
          }
        },
        {
          "name": "1g eSignet auth-code (consent to share claims)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('auth code issued', () => { pm.response.to.have.status(200); pm.expect(body.errors || []).to.be.empty; pm.expect(body.response.code).to.be.ok; });",
                  "pm.collectionVariables.set('auth_code', body.response.code);",
                  "pm.collectionVariables.set('auth_state', body.response.state);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "oauth-details-key",
                "value": "{{txn}}"
              },
              {
                "key": "oauth-details-hash",
                "value": "{{oauth_hash}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{esignet_api_url}}/authorization/auth-code",
            "body": {
              "mode": "raw",
              "raw": "{\"requestTime\": \"{{now}}\", \"request\": {\"transactionId\": \"{{txn}}\", \"acceptedClaims\": [\"individual_id\", \"name\"], \"permittedAuthorizeScopes\": []}}"
            },
            "description": "eSignet: the farmer accepts sharing `individual_id` and `name`; eSignet issues the authorization code for the redirect URI.\n\nThis is one of the calls the eSignet login page makes (the collection plays the page, so no browser is needed). It works with eSignet's **mock identity system** only (fixed OTP); against a real ID system log in through the browser instead."
          }
        },
        {
          "name": "1h Bene API callback -> one-time code (JSON)",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 JSON code (API client, no redirect)', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().code).to.be.ok; });",
                  "pm.collectionVariables.set('login_code', pm.response.json().code);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{bene_api_url}}/beneficiary/auth/callback?state={{auth_state}}&code={{auth_code}}",
            "description": "The redirect URI eSignet sends the browser to. The CM exchanges the code with eSignet (`private_key_jwt`), checks the ID token and userinfo, and answers an API client with a one-time code (JSON, valid 120 s)."
          }
        },
        {
          "name": "1i Token (one-time code -> bene API token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json();",
                  "pm.test('bene API token for the FIN', () => { pm.response.to.have.status(200); pm.expect(t.subject_id.value).to.eql(pm.variables.get('farmer_national_id')); pm.expect(t.token_type).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('bene_token', t.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bene_api_url}}/beneficiary/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\"code\": \"{{login_code}}\"}"
            },
            "description": "Exchanges the one-time code for the **bene API token** (CM-signed, `typ: bene+jwt`, 30 min)."
          }
        },
        {
          "name": "1j Token again with the same code -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code works once', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{bene_api_url}}/beneficiary/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\"code\": \"{{login_code}}\"}"
            },
            "description": "A one-time code works once: the second exchange is refused (`400`)."
          }
        },
        {
          "name": "1k Callback again with the same state -> 400",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
