                  "        pm.response.to.have.status(200);",
                  "    });",
                  "    var json = pm.response.json();",
                  "    pm.test('Has total and items list', function () {",
                  "        pm.expect(json).to.have.property('total');",
                  "        pm.expect(json.items).to.be.an('array');",
                  "    });",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staff_token}}"
              }
            ],
            "url": {
              "raw": "{{cm_url}}/consent/v1/verifications",
              "host": [
                "{{cm_url}}"
              ],
              "path": [
                "consent",
